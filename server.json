{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tobilektri/mcp-cookidoo",
  "title": "Cookidoo for Thermomix (unofficial)",
  "description": "Thermomix recipes with guided cooking in Cookidoo, recipe search, week plan and shopping list",
  "repository": {
    "url": "https://github.com/tobilektri/mcp-cookidoo",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-cookidoo",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "COOKIDOO_EMAIL",
          "description": "E-mail address of your Cookidoo account",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "COOKIDOO_PASSWORD",
          "description": "Password of your Cookidoo account",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "COOKIDOO_COUNTRY",
          "description": "Cookidoo country code, e.g. de (default), at, ch, fr",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "COOKIDOO_LANGUAGE",
          "description": "Cookidoo language, e.g. de-DE (default), fr-FR",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
